#!/usr/bin/env bash

# ~/dotfiles/scripts/tmux/sessionizer -- handle tmux templates
# NOTE: make sure to check the `configFile` variable

set -euo pipefail

configFile="$HOME/dotfiles/scripts/tmux/projects.ini"

if [[ ! -f "$configFile" ]]; then
	echo "error: config file not found at $configFile" >&2
	exit 1
fi

sectionNames=$(grep -oP '^\[\K[^\]]+' "$configFile")
selectedProject=$(echo "$sectionNames" | fzf --prompt="project: ")
[[ -z "$selectedProject" ]] && exit 0

sessionName=$(echo "$selectedProject" | tr '.' '_')

sessionExists=false
if tmux has-session -t "$sessionName" 2>/dev/null; then
	sessionExists=true
fi

if ! $sessionExists; then
	mapfile -t rawLines < <(awk -v proj="$selectedProject" '
		/^\[.*\]$/ {
			inSection = ($0 == "[" proj "]")
			next
		}
		inSection && NF && !/^[;#]/ {
			print
		}
	' "$configFile")

	if [[ ${#rawLines[@]} -eq 0 ]]; then
		echo "error: section [$selectedProject] has no keys" >&2
		exit 1
	fi

	pathLine=""
	windowLines=()
	for line in "${rawLines[@]}"; do
		key="${line%%=*}"
		key="${key// /}"
		if [[ "$key" == "path" ]]; then
			pathLine="$line"
		else
			windowLines+=("$line")
		fi
	done

	if [[ ${#windowLines[@]} -eq 0 ]]; then
		if [[ -z "$pathLine" ]]; then
			echo "error: section [$selectedProject] has no path and no windows" >&2
			exit 1
		fi
		pathDir="${pathLine#*=}"
		pathDir="${pathDir# }"
		windowLines=("ops = $pathDir")
	fi

	firstWindow=true
	for line in "${windowLines[@]}"; do
		windowName="${line%%=*}"
		windowName="${windowName// /}"

		windowRest="${line#*=}"
		windowRest="${windowRest# }"

		windowDir="${windowRest%%::*}"
		windowDir="${windowDir% }"

		windowCmd=""
		if [[ "$windowRest" == *"::"* ]]; then
			windowCmd="${windowRest#*::}"
			windowCmd="${windowCmd# }"
		fi

		if $firstWindow; then
			tmux new-session -d -s "$sessionName" -n "$windowName" -c "$windowDir"
			firstWindow=false
		else
			tmux new-window -t "$sessionName" -n "$windowName" -c "$windowDir"
		fi

		if [[ -n "$windowCmd" ]]; then
			tmux send-keys -t "${sessionName}:${windowName}" "$windowCmd" C-m
		fi
	done

	tmux select-window -t "${sessionName}:1"
fi

if [[ -z "${TMUX:-}" ]]; then
	tmux attach -t "$sessionName"
else
	tmux switch-client -t "$sessionName"
fi
